from pathlib import Path

import cv2
import numpy as np
import matplotlib
matplotlib.use("Agg")          
import matplotlib.pyplot as plt


IMAGE_PATH = r"file_path"           # insert file path
OUT_DIR = Path("lines_out")         # output folder

BLUR_SIZE = 51     
SIGMA = 14       
PROMINENCE = 0.15 
MIN_PEAK_GAP = 60   
PAD = 8             
DROP_FAINT = 0.25   


def compute_ink_map(img: np.ndarray, blur_size: int) -> np.ndarray:
    # per-pixel distance of the colour from the local background colour
    bg = cv2.medianBlur(img, blur_size)
    diff = img.astype(np.float32) - bg.astype(np.float32) 
    ink = np.linalg.norm(diff, axis=2)
    ink -= np.median(ink)
    return np.clip(ink, 0, None)


