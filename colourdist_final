def main():
    img = cv2.imread(IMAGE_PATH)                       # stays in BGR 
    if img is None:
        raise FileNotFoundError(f"Couldn't open the image: {IMAGE_PATH}")
    h, w = img.shape[:2]
    print("image size:", img.shape)

    OUT_DIR.mkdir(parents=True, exist_ok=True)

    # 1. ink map
    ink = compute_ink_map(img, BLUR_SIZE)
    cv2.imwrite(str(OUT_DIR / "ink_map.png"), (255 * ink / ink.max()).astype(np.uint8))

    # 2-4. row profile, smoothing, peaks, cuts
    cuts, peaks, profile, smooth = find_cuts(ink)
    print(f"{len(peaks)} peaks found at rows: {peaks.tolist()}")

    # plot 
    rows = np.arange(len(profile))
    plt.figure(figsize=(6, 10))
    plt.plot(profile, rows, color="lightgray", label="raw")
    plt.plot(smooth, rows, color="red", label="smoothed")
    plt.scatter(smooth[peaks], peaks, color="blue", zorder=3, label="lines")
    for y in cuts:
        plt.axhline(y, color="green", lw=0.8)
    plt.gca().invert_yaxis()
    plt.xlabel("ink amount")
    plt.ylabel("row number")
    plt.legend()
    plt.savefig(OUT_DIR / "profile.png", dpi=100)
    plt.close()

    bands = list(zip(cuts[:-1], cuts[1:]))
    band_ink = np.array([ink[t:b].sum() for t, b in bands])
    keep = band_ink >= DROP_FAINT * np.median(band_ink)
    bands = [bd for bd, k in zip(bands, keep) if k]
    print(f"Keeping {len(bands)} of {len(keep)} bands")

    vis = img.copy()
    for top, bottom in bands:
        cv2.line(vis, (0, top), (w, top), (0, 0, 255), 2)
        cv2.line(vis, (0, bottom - 1), (w, bottom - 1), (0, 0, 255), 2)
    cv2.imwrite(str(OUT_DIR / "cuts_overlay.png"), vis)

    for i, (top, bottom) in enumerate(bands, 1):
        crop = img[max(0, top - PAD):min(h, bottom + PAD), :]
        cv2.imwrite(str(OUT_DIR / f"line_{i:03d}.png"), crop)

    print(f"saved {len(bands)} line images to {OUT_DIR.resolve()}")


if __name__ == "__main__":
    main()